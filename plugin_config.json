            "type": "llm_provider",
            "default": "",
            "value": "provider-8"
          },
          "model_id": {
            "title": "qwen_coder 模型组 模型",
            "description": "先选提供商，这里才能选它名下的模型；留空就用该提供商的默认模型。换提供商时这里会自动清空。",
            "type": "llm_model",
