  "models": {
    "title": "模型分组",
    "description": "可复用的模型组：先在这里配好模型，下方「角色配置」按组名引用。每组优先用提供商/模型下拉选择，旧手填字段仅作兼容。",
    "type": "object",
    "fields": {
      "deepseek": {
        "title": "模型组 deepseek",
        "type": "object",
        "fields": {
          "api_url": {
            "title": "API 地址",
            "type": "string",
            "default": "",
            "value": "https://api.deepseek.com",
            "deprecated": true,
            "description": "旧版手填字段：只有提供商下拉留空、且地址/Key/模型都填全时才生效。建议改用提供商下拉选择。"
          },
          "api_key": {
            "title": "API Key",
            "type": "string",
            "default": "",
            "value": "",
            "deprecated": true,
            "description": "旧版手填字段：只有提供商下拉留空、且地址/Key/模型都填全时才生效。建议改用提供商下拉选择。"
          },
          "model": {
            "title": "模型名",
            "type": "string",
            "default": "deepseek-ai/DeepSeek-V3.2",
            "value": "deepseek-v4-pro",
            "deprecated": true,
            "description": "旧版手填字段：只有提供商下拉留空、且地址/Key/模型都填全时才生效。建议改用提供商下拉选择。"
          },
          "provider_id": {
            "title": "deepseek 模型组 提供商",
            "description": "选了这里就优先用它（提供商在 WebUI「LLM 配置」页管理），旧的手填地址/Key/模型会被忽略；留空时才看旧手填字段，都没填就用主对话模型。",
            "type": "llm_provider",
            "default": "",
            "value": "provider-8"
          },
          "model_id": {
            "title": "deepseek 模型组 模型",
            "description": "先选提供商，这里才能选它名下的模型；留空就用该提供商的默认模型。换提供商时这里会自动清空。",
            "type": "llm_model",
            "provider_field": "models.deepseek.provider_id",
            "default": "",
            "value": "DeepSeek-V4-pro"
          }
        },
        "description": "角色配置里「模型组」填 deepseek 的分身，都用这一组模型。"
      },
      "qwen_coder": {
        "title": "模型组 qwen_coder",
        "type": "object",
        "fields": {
          "api_url": {
            "title": "API 地址",
            "type": "string",
            "default": "",
            "value": "https://api.deepseek.com",
            "deprecated": true,
            "description": "旧版手填字段：只有提供商下拉留空、且地址/Key/模型都填全时才生效。建议改用提供商下拉选择。"
          },
          "api_key": {
            "title": "API Key",
            "type": "string",
            "default": "",
            "value": "",
            "deprecated": true,
            "description": "旧版手填字段：只有提供商下拉留空、且地址/Key/模型都填全时才生效。建议改用提供商下拉选择。"
          },
          "model": {
            "title": "模型名",
            "type": "string",
            "default": "Qwen/Qwen3-Coder-480B-A35B-Instruct",
            "value": "deepseek-v4-pro",
